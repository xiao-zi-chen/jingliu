# Node.js >= 22.13 is required for the built-in SQLite database.
# Supply these through your process environment, or:
# node --env-file=.env server/index.mjs
PORT=4174
HOST=127.0.0.1
DATABASE_PATH=./data/jingliu.sqlite
# Enable when served over HTTPS in production.
COOKIE_SECURE=false
# Enable only behind your own single trusted reverse proxy.
TRUST_PROXY=false
